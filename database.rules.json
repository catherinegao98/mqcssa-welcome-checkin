{
  "rules": {
    "counter": {
      ".read": true,
      ".write": true,
      ".validate": "newData.isNumber() && newData.val() > 0"
    },
    "registrations": {
      ".read": true,
      "$deviceId": {
        ".write": "!data.exists() || !newData.exists()",
        ".validate": "newData.hasChildren(['number','code','group','groupIndex','ts'])"
      }
    }
  }
}
